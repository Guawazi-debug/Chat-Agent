{
  "name": "ai-chat-desktop",
  "version": "1.6.2",
  "description": "AI 对话系统 - 多模型集成桌面版",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable"
  },
  "author": "AI Chat Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.aichat.desktop",
    "productName": "AI对话系统",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI对话系统"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "app.js",
      "config.js",
      "memory.js",
      "styles.css",
      "secrets.js",
      "icon.ico",
      "logo.png",
      "package.json"
    ]
  }
}
